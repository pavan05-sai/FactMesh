# LLM Provider Configuration
# Choose: "openrouter" or "openai"
LLM_PROVIDER=openrouter

# OpenRouter Settings (when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-api-key
OPENROUTER_MODEL=google/gemini-2.0-flash-001
# Optional: OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI Settings (when LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Optional: OPENAI_BASE_URL=https://api.openai.com/v1

# Web Search (Tavily with Wikipedia fallback)
TAVILY_API_KEY=tvly-your-tavily-api-key

# Timeouts & Retries
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2
SEARCH_TIMEOUT_MS=10000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/factmesh

# JWT Authentication
JWT_SECRET=change-this-to-a-random-secret-string

# Server
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Client (Vite)
VITE_API_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
